rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function paidOwner(uid) {
      let path = /databases/$(database)/documents/subscriptions/$(uid);
      return owner(uid) && exists(path)
        && get(path).data.status == "active"
        && get(path).data.plan in ["basic", "premium", "ultra", "duka", "biashara"]
        && get(path).data.expiresAt is timestamp
        && get(path).data.expiresAt > request.time;
    }
    function member(uid) {
      let path = /databases/$(database)/documents/businesses/$(uid)/members/$(request.auth.uid);
      return signedIn() && exists(path) && get(path).data.status == "active";
    }
    function allowed(uid, permission) {
      return member(uid) && permission in get(/databases/$(database)/documents/businesses/$(uid)/members/$(request.auth.uid)).data.permissions;
    }
    function canRead(uid, permission) { return owner(uid) || allowed(uid, permission); }
    function canWrite(uid, permission) { return paidOwner(uid) || (allowed(uid, permission) && paidOwner(uid)); }

    match /subscriptions/{uid} {
      allow read: if owner(uid);
      allow create, update, delete: if false;
    }
    // Shop records remain in their original owner-scoped paths. Staff access is
    // granted through server-managed business membership and per-module rights.
    match /users/{uid}/products/{doc} {
      allow read: if canRead(uid, "products");
      allow create, update, delete: if canWrite(uid, "products");
    }
    match /users/{uid}/customers/{doc} {
      allow read: if canRead(uid, "customers");
      allow create, update, delete: if canWrite(uid, "customers");
    }
    match /users/{uid}/sales/{doc} {
      allow read: if canRead(uid, "sales");
      allow create, update, delete: if canWrite(uid, "sales");
    }
    match /users/{uid}/expenses/{doc} {
      allow read: if canRead(uid, "expenses");
      allow create, update, delete: if canWrite(uid, "expenses");
    }
    match /users/{uid}/data/{doc} {
      allow read: if canRead(uid, "overview");
      allow create, update, delete: if canWrite(uid, "overview");
    }
    // Membership and invitation records are written only by the trusted API.
    match /businesses/{uid}/members/{memberUid} {
      allow read, write: if false;
    }
    match /staffInvites/{token} {
      allow read, write: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}