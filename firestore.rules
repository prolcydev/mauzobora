rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function activePaid(uid) {
      let path = /databases/$(database)/documents/subscriptions/$(uid);
      return exists(path)
        && get(path).data.status == "active"
        && get(path).data.plan in ["basic", "premium", "ultra", "duka", "biashara"]
        && get(path).data.expiresAt is timestamp
        && get(path).data.expiresAt > request.time;
    }
    function member(uid) {
      let path = /databases/$(database)/documents/businesses/$(uid)/members/$(request.auth.uid);
      return signedIn() && exists(path) && get(path).data.status == "active";
    }
    function allowed(uid, permission) {
      return member(uid) && permission in get(/databases/$(database)/documents/businesses/$(uid)/members/$(request.auth.uid)).data.permissions;
    }
    function canRead(uid, permission) { return owner(uid) || allowed(uid, permission); }
    function canWrite(uid, permission) { return (owner(uid) || allowed(uid, permission)) && activePaid(uid); }

    match /subscriptions/{uid} {
      allow read: if owner(uid);
      allow create, update, delete: if false;
    }
    match /users/{uid}/products/{doc} {
      allow read: if canRead(uid, "products") || allowed(uid, "pos");
      allow create, delete: if canWrite(uid, "products");
      allow update: if canWrite(uid, "products")
        || (canWrite(uid, "pos") && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stock"]));
    }
    match /users/{uid}/customers/{doc} {
      allow read: if canRead(uid, "customers") || allowed(uid, "pos");
      allow create, delete: if canWrite(uid, "customers");
      allow update: if canWrite(uid, "customers")
        || (canWrite(uid, "pos") && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["bal"]));
    }
    match /users/{uid}/sales/{doc} {
      allow read: if canRead(uid, "sales") || allowed(uid, "pos");
      allow create, update, delete: if canWrite(uid, "sales") || canWrite(uid, "pos");
    }
    match /users/{uid}/expenses/{doc} {
      allow read: if canRead(uid, "expenses");
      allow create, update, delete: if canWrite(uid, "expenses");
    }
    match /users/{uid}/data/{doc} {
      allow read: if canRead(uid, "overview") || allowed(uid, "pos");
      allow create, delete: if canWrite(uid, "overview");
      allow update: if canWrite(uid, "overview")
        || (canWrite(uid, "pos") && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["next"]));
    }
    match /businesses/{uid}/members/{memberUid} { allow read, write: if false; }
    match /staffInvites/{token} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}