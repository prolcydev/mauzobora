{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/subscribe.js": {
      "maxDuration": 30
    }
  },
  "redirects": [
    {
      "source": "/app.html",
      "destination": "/app",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    }
  ]
}